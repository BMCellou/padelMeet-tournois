# Copie ce fichier en .env.local et remplis les valeurs réelles.
# Jamais commité (voir .gitignore : .env*).

# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Utilisée uniquement côté serveur (jamais NEXT_PUBLIC_) : Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Unique adresse admin autorisée à recevoir un magic link (src/app/admin/login/actions.ts)
ADMIN_EMAIL=

# URL publique du site, utilisée pour construire le lien de retour du magic link
# (ex. http://localhost:3000 en dev, https://ton-domaine.vercel.app en prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rappels de match — e-mail (Resend : resend.com > API Keys ; RESEND_FROM = expéditeur d'un domaine vérifié)
RESEND_API_KEY=
RESEND_FROM="PadelMeet <rappels@ton-domaine.fr>"

# Rappels de match — API WhatsApp Cloud (Meta). Le modèle doit être approuvé et
# avoir 5 variables dans le corps : {{1}} prénom, {{2}} tournoi, {{3}} adversaires,
# {{4}} date et heure, {{5}} terrain.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr

# Secret du cron /api/cron/rappels (Vercel l'envoie en Bearer) : une longue chaîne aléatoire
CRON_SECRET=

# Sauvegarde complète de la base (cron /api/cron/backup-db, quotidien) —
# réutilise CRON_SECRET défini plus haut. Nécessaire sur un plan Supabase
# gratuit (pas de sauvegarde automatique incluse).
